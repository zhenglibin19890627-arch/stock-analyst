# Python 字节码与缓存
__pycache__/
*.pyc

# 测试/静态分析缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 数据库文件
*.db
*.db-shm
*.db-wal

# 每日报告生成产物（根目录 reports/；docs/reports/ 为历史归档，保持跟踪）
/reports/

# 日志文件（含按日期轮转的日志）
logs/

# 破坏性操作前自动生成的数据库备份
backups/

# 运行/环境工具目录
.qoder/
.reasonix/
.reasonix_tmp/

# 一次性诊断/生成脚本残留
_tmp_*.py
